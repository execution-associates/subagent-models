[Unit]
Description=subagent-models gateway: Claude Code subagents on non-Claude models
Documentation=file:%h/projects/exa/subagent-models/README.md
After=network-online.target
# A broken config exits 78; keep trying so a fixed config is picked up without a manual restart.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/share/mise/shims/bun %h/projects/exa/subagent-models/gateway/src/cli.ts serve
# op (the caching wrapper) and mise's shims; nothing else from the login shell.
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=3
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
