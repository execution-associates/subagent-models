[Unit]
Description=subagent-models: keep the omp SDK in step with the installed omp
Documentation=file:%h/projects/exa/subagent-models/README.md

[Service]
Type=oneshot
ExecStart=%h/.local/share/mise/shims/bun %h/projects/exa/subagent-models/gateway/src/cli.ts omp-sdk sync
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
NoNewPrivileges=yes
UMask=0077
TimeoutStartSec=20min
